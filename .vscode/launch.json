{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run PLC ST Copilot extension",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}/vscode-ext"],
      "outFiles": ["${workspaceFolder}/vscode-ext/out/**/*.js"],
      "preLaunchTask": "compile-plc-extension"
    }
  ]
}
